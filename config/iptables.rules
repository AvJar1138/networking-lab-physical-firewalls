*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# =======================================================
# 1. ALLOW ESTABLISHED & RELATED TRAFFIC
# =======================================================

-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# =======================================================
# 2. BLACKLIST / THREAT MITIGATION
# =======================================================

# Block blacklisted threat actor (replace with actual IP)
# -A FORWARD -s 172.16.1.200 -j DROP

# Drop invalid packets
-A INPUT -m conntrack --ctstate INVALID -j DROP
-A FORWARD -m conntrack --ctstate INVALID -j DROP

# =======================================================
# 3. LAN TO DMZ & WAN ACCESS
# =======================================================

# LAN -> DMZ: allow HTTP and HTTPS
-A FORWARD -s 10.1.1.0/24 -d 192.168.10.0/24 -p tcp -m multiport --dports 80,443 -m conntrack --ctstate NEW -j ACCEPT

# LAN -> WAN: allow HTTP and HTTPS
-A FORWARD -s 10.1.1.0/24 -d 172.16.1.0/24 -p tcp -m multiport --dports 80,443 -m conntrack --ctstate NEW -j ACCEPT

# =======================================================
# 4. WAN TO DMZ ACCESS
# =======================================================


# Allow WAN clients to access the DMZ web server via HTTP
-A FORWARD -s 172.16.1.0/24 -d 192.168.10.10/32 -p tcp --dport 80 -m conntrack --ctstate NEW -j ACCEPT

# Allow WAN clients to access the DMZ web server via HTTPS
-A FORWARD -s 172.16.1.0/24 -d 192.168.10.10/32 -p tcp --dport 443 -m conntrack --ctstate NEW -j ACCEPT

COMMIT
